{
  "manifest_version": 3,
  "name": "UnCapped Download Integration",
  "version": "1.0.0",
  "description": "Accelerate Google Chrome downloads across multiple bonded network interfaces using UnCapped.",
  "permissions": ["downloads", "contextMenus", "storage", "cookies"],
  "host_permissions": ["http://127.0.0.1:23851/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
